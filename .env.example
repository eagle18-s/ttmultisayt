# Discord Application (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=your_client_id
DISCORD_CLIENT_SECRET=your_client_secret
DISCORD_BOT_TOKEN=your_bot_token
DISCORD_CALLBACK_URL=https://your-app.onrender.com/auth/discord/callback

# Your personal Discord User ID (right-click yourself in Discord → Copy User ID)
# Enable Developer Mode in Discord settings first
OWNER_DISCORD_ID=123456789012345678

# Session
SESSION_SECRET=change-this-to-a-long-random-string

# Optional: force self URL (Render sets RENDER_EXTERNAL_URL automatically)
# SELF_URL=https://your-app.onrender.com
# PORT=3000
